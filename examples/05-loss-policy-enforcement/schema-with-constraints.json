{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "PaymentIntent",
  "description": "Payment authorization payload with strict financial invariants",
  "type": "object",
  "properties": {
    "amount": {
      "type": "integer",
      "minimum": 100,
      "maximum": 50000000
    },
    "currency": {
      "type": "string",
      "minLength": 3,
      "maxLength": 3
    },
    "customerEmail": {
      "type": "string",
      "format": "email"
    }
  },
  "required": ["amount", "currency", "customerEmail"]
}
