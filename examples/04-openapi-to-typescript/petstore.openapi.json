{
  "openapi": "3.1.0",
  "info": {
    "title": "Swagger Petstore Models",
    "description": "Domain data models from the Petstore OpenAPI 3.1 specification",
    "version": "1.0.0"
  },
  "paths": {},
  "components": {
    "schemas": {
      "Category": {
        "type": "object",
        "description": "Pet category classification",
        "properties": {
          "id": {
            "type": "integer"
          },
          "name": {
            "type": "string"
          }
        },
        "required": ["id", "name"]
      },
      "Tag": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer"
          },
          "name": {
            "type": "string"
          }
        },
        "required": ["id", "name"]
      },
      "Pet": {
        "type": "object",
        "description": "Pet entity in the store",
        "properties": {
          "id": {
            "type": "integer"
          },
          "name": {
            "type": "string"
          },
          "category": {
            "$ref": "#/components/schemas/Category"
          },
          "photoUrls": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "tags": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Tag"
            }
          },
          "status": {
            "type": "string",
            "enum": ["available", "pending", "sold"],
            "default": "available"
          }
        },
        "required": ["id", "name", "photoUrls"]
      }
    }
  }
}
