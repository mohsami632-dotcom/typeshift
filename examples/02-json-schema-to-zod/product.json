{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Product",
  "description": "Inventory product with pricing and classification constraints",
  "type": "object",
  "properties": {
    "sku": {
      "type": "string",
      "minLength": 3,
      "maxLength": 30
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "price": {
      "type": "number",
      "minimum": 0
    },
    "stock": {
      "type": "integer",
      "minimum": 0
    },
    "category": {
      "type": "string",
      "enum": ["electronics", "apparel", "home", "books"]
    },
    "websiteUrl": {
      "type": "string",
      "format": "uri"
    }
  },
  "required": ["sku", "name", "price", "stock", "category"]
}
